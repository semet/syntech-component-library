{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/App.{js,jsx,ts,tsx}", "src/main.{js,jsx,ts,tsx}"],
  "project": ["**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}"],
  "ignore": [
    ".storybook/**",
    "src/components/**",
    "src/utils/**",
    "src/examples/**",
    "src/test/**"
  ],
  "ignoreDependencies": [
    "@hookform/resolvers",
    "@testing-library/user-event",
    "react-hook-form",
    "zod"
  ]
}

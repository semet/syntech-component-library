{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/App.{js,jsx,ts,tsx}",
    "src/main.{js,jsx,ts,tsx}",
    "src/components/index.ts",
    "src/icons/index.ts",
    "src/utils/index.ts"
  ],
  "project": ["**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}", "!src/stories/**"],
  "ignore": ["src/examples/**", "src/test/**", ".storybook/**"],
  "ignoreDependencies": [
    "vite-tsconfig-paths",
    "@hookform/resolvers",
    "@testing-library/user-event",
    "zod"
  ],
  "includeEntryExports": false
}
